{
  "compilerOptions": {
    "target": "ES2022",
    // esbuild does the actual emit (it strips types natively); tsc is the
    // type-checker only.
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["chrome"],
    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true
  },
  "include": [
    "src/**/*.ts",
    "types/**/*.d.ts",
    "../app/types/protocol.d.ts"
  ]
}
